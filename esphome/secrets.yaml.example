# Copy this file to secrets.yaml (in the same esphome/ folder) and fill in
# your own values. secrets.yaml is gitignored — never commit the real one.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# 32-byte base64 key for the ESPHome native API's encryption. If you create
# the device through the ESPHome dashboard's "New Device" wizard, it
# generates this for you automatically — just copy it in here. Otherwise
# generate one yourself, e.g.:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
dartboard_api_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# Password for OTA (over-the-air) firmware updates — pick anything reasonably
# strong, you'll only need it if you ever fall back to entering OTA recovery.
dartboard_ota_password: "CHOOSE_A_PASSWORD"
